# 复制为 .env 后按需修改
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=1

# 前端静态服务器地址，逗号分隔；本地开发可用 *
CORS_ORIGINS=*

# echo = 离线回声模式（默认，不需要任何 key）
# openai = 走 OpenAI 兼容接口
LLM_PROVIDER=echo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

SYSTEM_PROMPT=你是一个简洁、友好的中文 AI 助手。
HISTORY_LIMIT=20
